# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=https://www.rcnnorthamerica.com

# Dashed "To confirm" markers on anything the ministry still has to confirm. false = hide all.
NEXT_PUBLIC_SHOW_PENDING=true

# Supabase. Without these, local dev writes form submissions to .data/submissions.ndjson
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only: used by the admin/team area after a leader signs in (never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Resend (confirmations + branch notifications). Optional; submissions are saved either way.
RESEND_API_KEY=
EMAIL_FROM="RCN North America <noreply@rcnnorthamerica.com>"
# Fallback inbox for anything that isn't routed to a branch.
NETWORK_INBOX=
# Optional per-branch override, e.g. INBOX_BOSTON=boston@rcnnorthamerica.com (defaults to the branch's public email)

# Cloudflare Turnstile (optional, on top of honeypot + timing)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
